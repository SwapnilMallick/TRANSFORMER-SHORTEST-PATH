# Whitelist: ignore everything, then re-include only Python scripts.
# Result folders, plots, logs, CSVs, checkpoints etc. are therefore ignored
# wherever they appear, without having to list each one.
*
!*/
!*.py
!.gitignore
!/README.md

# Never descend into these, even for .py files (order matters: these must
# come after the re-includes above).

# Virtual environments / vendored code
.venv/
venv/
env/
ENV/
site-packages/
third_party/

# Python build / cache
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.eggs/
build/
dist/

# Editor / IDE
.idea/
.vscode/

# Folders and scripts kept out of the repo on purpose
/boxoban_feasibility/
/mbm_vamp_render/
/new_maze_envs_v5/
/new_maze_envs_minihack/tests/
/new_maze_envs_minihack/_baseline/
/new_maze_envs_minihack/run_width_ablation.py
